{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "k8sql",
  "version": "0.1.0",
  "identifier": "com.pvgiang396.k8sql",
  "build": {
    "frontendDist": "../server/public"
  },
  "app": {
    "windows": [
      {
        "title": "k8sql",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
